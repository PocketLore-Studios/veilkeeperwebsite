---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevlogMedia from '../components/DevlogMedia.astro';
import { getSortedDevlogs, getPostUrl } from '../lib/devlog';
import { SITE } from '../lib/site';

const devlogs = await getSortedDevlogs();
const latest = devlogs[0];

// The run, in the order a player meets it. Screenshots are the press captures
// from the v0.1.0.0 alpha (see src/pages/press/index.astro); the copy matches
// the press kit's "The demo run" so the two pages never disagree. The draft and
// leave-behind screens are mostly empty frame around a small central menu, so
// the homepage uses 800x450 crops of that menu (public/assets/home/):
//   ffmpeg -i press-squad-draft.webp -vf crop=800:450:560:320 -c:v libwebp -lossless 1 -compression_level 6 loop-draft.webp
//   ffmpeg -i press-leave-behind.webp -vf crop=800:450:560:315 -c:v libwebp -lossless 1 -compression_level 6 loop-leave-behind.webp
const loop = [
    {
        title: 'Draft your squad',
        text: 'Pick six units from a pool of twelve - Knights, Archers, Assassins and Maulers - with the first fight’s opposition shown up front.',
        src: '/assets/home/loop-draft.webp',
        width: 800,
        height: 450,
        alt: 'The draft screen reading "Squad: 6 / 6" above a grid of twelve unit choices, with a header noting the first fight has three enemies: 1 Knight, 1 Archer, 1 Mauler',
    },
    {
        title: 'Fight on the grid',
        text: 'Turn-based tactics with facing and positional damage. Every attack shows its damage, and whether it draws a counter, before you commit.',
        src: '/assets/press/press-damage-preview.webp',
        width: 1920,
        height: 1080,
        alt: 'Attack confirmation showing 32 damage, the target dropping from 45 to 13 HP, and "No counter", above a prompt reading "Click again to confirm"',
    },
    {
        title: 'Leave one behind',
        text: 'Between fights, one unit stays to hold the relay. Your force shrinks from six to four while the enemy grows from three to five.',
        src: '/assets/home/loop-leave-behind.webp',
        width: 800,
        height: 450,
        alt: 'A screen reading "The signal grows weak - Leave a Unit Behind to hold the connection", listing six surviving units, noting the next fight has four enemies, and "Leaving behind: 0 / 1"',
    },
];
---
<BaseLayout
        title="Veilkeeper | Tactical RPG by PocketLore Studios"
        description="Veilkeeper is a tactical RPG where your army shrinks the deeper you push. Draft a squad, fight, and choose who stays behind. Free alpha on itch.io for Windows and Linux."
>
  <section class="hero">
    {/* Decorative: the hero's meaning is carried by the heading and logo beside it,
        and .hero::before lays the readability gradients over the top.

        Two crops because the hero's aspect swings from ~1.7 on desktop to ~0.35 on a
        phone. The landscape key art centre-crops to empty sky at that width, so narrow
        viewports get the portrait composition, which runs top-to-bottom and keeps both
        the rift and the figure in frame. */}
    <picture>
      <source
              media="(max-width: 720px)"
              srcset="/assets/hero/veilkeeper-key-art-hero-portrait.webp"
              width="1100"
              height="1468"
      >
      <img
              class="hero-bg"
              src="/assets/hero/veilkeeper-key-art-hero.webp"
              alt=""
              width="2560"
              height="1462"
              fetchpriority="high"
      >
    </picture>
    <div class="container">
      <div class="hero-content">
        <div class="eyebrow">Public alpha • Tactical RPG</div>

        <h1>Your army shrinks the deeper you push.</h1>
        <p class="lead">
          Choose who stays behind. How far can you go before the connection breaks?
        </p>
        <p class="sublead">
          Draft a squad, fight on a tactical grid, and after every battle leave one unit behind
          to hold the relay. Each fight is bigger than the last - and your army only gets smaller.
        </p>

        <div class="actions">
          <a class="button button--primary" href={SITE.itchUrl} target="_blank" rel="noopener noreferrer">
            Play the alpha
          </a>

          <a class="button button--ember" href={SITE.steamUrl} target="_blank" rel="noopener noreferrer">
            Wishlist on Steam
          </a>

          <a class="button button--discord" href={SITE.social.discord} target="_blank" rel="noopener noreferrer">
            Join Discord
          </a>
        </div>

        <p class="availability">
          Free on itch.io · Windows and Linux · Mouse, keyboard, or controller
        </p>

        <p class="notice">
          Veilkeeper is in active early development. The alpha is the tactical combat layer;
          art is placeholder and everything shown may change.
        </p>
      </div>
    </div>
  </section>

  {/* id="features" rather than "gameplay": this replaced the old feature-card
      section, and /#features links are already out in the wild. */}
  <section id="features" class="section">
    <div class="container">
      <div class="section-heading">
        <h2>How a run plays</h2>
        <p>
          The alpha is a short expedition: three fights, about five minutes, and one hard
          choice between each of them.
        </p>
      </div>

      <ol class="loop-steps">
        {loop.map((step, index) => (
          <li class="card surface loop-step">
            <img src={step.src} alt={step.alt} width={step.width} height={step.height} loading="lazy">
            <div class="loop-step-body">
              <span class="phase-kicker">Step {index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="loop-note">
        Screens from the v0.1 alpha. Unit and terrain artwork is placeholder.
      </p>

      <div class="actions loop-actions">
        <a class="button button--primary" href={SITE.itchUrl} target="_blank" rel="noopener noreferrer">
          Play the free alpha
        </a>
        <a class="button button--secondary" href="/press/#screenshots">
          More screenshots
        </a>
      </div>
    </div>
  </section>

  <section id="status" class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Development Status</h2>
        <p>
          The latest public-facing update from current development.
        </p>
      </div>

      {latest ? (
        <article class="status-update surface">
          <DevlogMedia entry={latest} href={getPostUrl(latest)} class="status-update-image" />
          <div class="status-update-body">
            <p class="status-update-kicker">Latest update</p>
            <p class="status-update-caption">
              <strong>{latest.data.label} - {latest.data.title}</strong>
              <br>
              {latest.data.summary}
            </p>
            <a href="/devlog/" class="link-row status-update-link">
              <div>
                <strong>View all updates</strong>
                <span>Browse the development log</span>
              </div>
              <span>↗</span>
            </a>
          </div>
        </article>
      ) : (
        <p>No updates yet.</p>
      )}
    </div>
  </section>

  {/* Replaces three overlapping sections (core pillars, current layer, roadmap)
      that each restated the same four layers. */}
  <section id="roadmap" class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Built in layers</h2>
        <p>
          Veilkeeper grows from the combat outward. Each layer has to stand on its own before
          the next is allowed to lean on it, and community features sit on top of the game -
          they never replace it.
        </p>
      </div>

      <div class="roadmap">
        <article class="roadmap-phase phase-expedition surface">
          <div class="phase-top">
            <span class="phase-kicker">Phase I</span>
            <h3 class="phase-title">The Expedition</h3>
          </div>
          <div class="phase-meta">
            <div class="phase-tag">Tactical combat</div>
            <div class="status-tag tag--current">Playable now</div>
          </div>
          <ul class="phase-list">
            <li>Grid combat with facing and positional damage across four unit roles</li>
            <li>The shrinking army: one unit left behind to hold the relay after every fight</li>
            <li>Mouse, keyboard, and controller support</li>
          </ul>
        </article>

        <article class="roadmap-phase phase-shard surface">
          <div class="phase-top">
            <span class="phase-kicker">Phase II</span>
            <h3 class="phase-title">The Shard</h3>
          </div>
          <div class="phase-meta">
            <div class="phase-tag">Home base</div>
            <div class="phase-status">Planned</div>
          </div>
          <ul class="phase-list">
            <li>A settlement you build and return to, which keeps moving while you are away</li>
            <li>Hero housing</li>
            <li>Cosmetic and systemic upgrades</li>
          </ul>
        </article>

        <article class="roadmap-phase phase-campaign surface">
          <div class="phase-top">
            <span class="phase-kicker">Phase III</span>
            <h3 class="phase-title">The Campaign</h3>
          </div>
          <div class="phase-meta">
            <div class="phase-tag">Rift campaign</div>
            <div class="phase-status">Planned</div>
          </div>
          <ul class="phase-list">
            <li>Relay networks stretched across the rift</li>
            <li>Node defense - deciding which links are worth holding</li>
            <li>Strategic pressure across the rift map</li>
          </ul>
        </article>

        <article class="roadmap-phase phase-community surface">
          <div class="phase-top">
            <span class="phase-kicker">Phase IV</span>
            <h3 class="phase-title">The Community</h3>
          </div>
          <div class="phase-meta">
            <div class="phase-tag">Stream integration</div>
            <div class="phase-status">Future</div>
          </div>
          <ul class="phase-list">
            <li>Viewer characters and stream events</li>
            <li>Community shards and audience participation</li>
            <li>Optional by design - Veilkeeper stays fully playable offline</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container grid-2">
      <div class="panel surface">
        <h3>What Veilkeeper is aiming for</h3>
        <p>
          Veilkeeper is built around the tension between presence and absence. You build
          something, you leave, the world keeps moving, and the choices you made before leaving
          determine what you come back to.
        </p>
        <p>
          The fantasy is not just winning fights. It is holding a fragile line, deciding what can
          be saved, and building something worth defending when you return.
        </p>
      </div>

      <div class="panel surface">
        <h3>Follow the project</h3>
        <p>
          Play the alpha, then tell us what worked and what did not - feedback from these early
          builds shapes what comes next.
        </p>

        <div class="direct-links">
          <a class="link-row" href="/feedback/">
            <div>
              <strong>Send feedback</strong>
              <span>Bugs, balance notes, and first impressions</span>
            </div>
            <span aria-hidden="true">→</span>
          </a>

          <a class="link-row" href={SITE.social.discord} target="_blank" rel="noopener noreferrer">
            <div>
              <strong>Discord</strong>
              <span>Community and project discussion</span>
            </div>
            <span aria-hidden="true">↗</span>
          </a>

          <a class="link-row" href={SITE.social.bluesky} target="_blank" rel="noopener noreferrer">
            <div>
              <strong>Bluesky</strong>
              <span>Short-form development posts</span>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
